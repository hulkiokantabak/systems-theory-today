{
  "name": "systems-theory-today-site",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Public reading website (Eleventy) for 'A Systems Theory for Today' — the reading surface of the two-surfaces plan (docs/THE_LIVING_DOCUMENT.md §7).",
  "license": "MIT",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('_site',{recursive:true,force:true}))\"",
    "check": "node scripts/run-checks.mjs",
    "ripple": "node scripts/ripple.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "markdown-it": "^14.1.0"
  }
}
