<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <!-- Self-contained except three allowlisted origins: Google Fonts (CSS+woff2), the Mermaid
       CDN (diagram render), and the author's shared GoatCounter (cookieless page-view counting).
       Strict allowlist; no inline scripts. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; img-src 'self' data: https://hulkiokantabak.goatcounter.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://gc.zgo.at https://cdnjs.cloudflare.com; connect-src https://hulkiokantabak.goatcounter.com; frame-src 'self'; worker-src 'self' blob:; manifest-src 'self'">
  <title>{% if page.url == '/' %}{{ site.title }}{% else %}{{ title }} · {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ site.tagline }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0c0d18">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/icon-32.png' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/icon-180.png' | url }}">
  <link rel="manifest" href="{{ '/manifest.webmanifest' | url }}">
  <meta name="apple-mobile-web-app-title" content="Systems Theory">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
  <meta property="og:title" content="{% if page.url == '/' %}{{ site.title }}{% else %}{{ title }}{% endif %}">
  <meta property="og:description" content="{{ site.tagline }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.origin }}{{ page.url | url }}">
  <meta property="og:image" content="{{ site.origin }}{{ '/assets/og.png' | url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
  <!-- Day/night theme, applied before first paint (no flash). External for the strict CSP. -->
  <script src="{{ '/assets/theme.js' | url }}"></script>
</head>
<body{% if fullwidth %} class="fullwidth"{% endif %}>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-head">
    <div class="head-inner wrap">
      <button type="button" class="theme-toggle" aria-label="Toggle day/night theme">☀</button>
      <a class="brand" href="{{ '/' | url }}">{{ site.title }}</a>
      <p class="brand-sub">{{ site.tagline }}</p>
      <nav class="topnav" aria-label="Primary">
        <a href="{{ '/' | url }}">Home</a>
        <a href="{{ '/summary/' | url }}">Summary</a>
        <a href="{{ '/about/' | url }}">About</a>
        <a href="{{ '/history/' | url }}">History</a>
        <a href="{{ '/panel/' | url }}">The panel</a>
        <a href="{{ '/outputs/candidate_theories/' | url }}">The theories</a>
        <a href="{{ '/diagrams/' | url }}">Facts &amp; figures</a>
        <a href="{{ '/logs/open_questions/' | url }}">Open questions</a>
        <a href="{{ '/colophon/' | url }}">Colophon</a>
      </nav>
    </div>
  </header>

  <div class="wrap layout">
    <!-- The drawer is SERVED OPEN: browsers that hide closed-details content via
         ::details-content{content-visibility:hidden} would otherwise leave the
         desktop sidebar (summary display:none) permanently invisible. JS closes
         it at narrow widths; without JS it degrades to an open, working list. -->
    <nav class="sidebar" aria-label="Contents">
    <details class="sidebar-drawer" open>
      <summary>Contents</summary>
      <div class="nav-inner">
        <p class="nav-filter" hidden><input id="navfilter" type="search" placeholder="Filter contents…" aria-label="Filter the contents list"></p>
        <div class="nav-group">
          <p class="nav-label">This site</p>
          <ul>
            <li><a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a></li>
            <li><a href="{{ '/summary/' | url }}"{% if page.url == '/summary/' %} aria-current="page"{% endif %}>Summary</a></li>
            <li><a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a></li>
            <li><a href="{{ '/history/' | url }}"{% if page.url == '/history/' %} aria-current="page"{% endif %}>The history</a></li>
            <li><a href="{{ '/panel/' | url }}"{% if page.url == '/panel/' %} aria-current="page"{% endif %}>The panel</a></li>
            <li><a href="{{ '/diagrams/' | url }}"{% if page.url == '/diagrams/' %} aria-current="page"{% endif %}>Facts &amp; figures</a></li>
            <li><a href="{{ '/colophon/' | url }}"{% if page.url == '/colophon/' %} aria-current="page"{% endif %}>Colophon</a></li>
          </ul>
        </div>
        {% for grp in nav %}
        <div class="nav-group">
          <p class="nav-label">{{ grp.group }}</p>
          <ul>
            {% for it in grp.items %}
            <li><a href="{{ it.url | url }}"{% if it.url == page.url %} aria-current="page"{% endif %}>{{ it.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </details>
    </nav>

    <main id="main" class="content{% if wide %} wide{% endif %}">
      {% if page.url != '/' %}<nav class="crumb" aria-label="Breadcrumb"><a href="{{ '/' | url }}">Home</a> <span>›</span> {{ title }}</nav>{% endif %}
      {% if page.url != '/' and not notools %}<div class="pagetools" aria-label="Page tools">
        <button type="button" class="pt-btn pt-pdf">↓ Save as PDF</button>
        <button type="button" class="pt-btn pt-share">↗ Share</button>
      </div>{% endif %}
      {% if page.url == '/docs/diagrams/' %}<p class="companion-note">Reading note: this is the canonical diagram log — the figures as editable text, the source of record. The same figures, presented with the project's self-reported counts, are on <a href="{{ '/diagrams/' | url }}">Facts &amp; figures</a>.</p>{% endif %}
      {% if page.url == '/' %}<p class="startnote">New here? Start with the <a href="{{ '/summary/' | url }}">Summary</a> — the project in plain language, including what has <em>not</em> yet been shown.</p>{% endif %}
      <article class="prose">
        {{ content | safe }}
      </article>
    </main>
  </div>

  <footer class="site-foot">
    <div class="wrap">
      <p><a href="{{ site.authorUrl }}">{{ site.author }}</a> · {{ site.license }}</p>
      <p class="dim"><a href="{{ '/about/' | url }}">About</a> · <a href="{{ '/history/' | url }}">The history</a> · <a href="{{ '/diagrams/' | url }}">Facts &amp; figures</a> · <a href="{{ '/colophon/' | url }}">Colophon</a> · <a href="{{ site.authorUrl }}">hulkiokantabak.com</a></p>
      <p class="dim">{{ site.repoNote }}</p>
      <p class="dim">{{ site.status }} · source of truth: the repository · figures render from Mermaid + one hand-authored SVG</p>
      <p class="dim">Analytics: privacy-respecting <a href="https://www.goatcounter.com/">GoatCounter</a> — cookieless, no cookies, no personal data (details in the <a href="{{ '/colophon/' | url }}">colophon</a>).</p>
      <p class="dim">The author's collected work — books, photographs, essays, and his other experiments — lives at <a href="{{ site.authorUrl }}">hulkiokantabak.com</a>.</p>
    </div>
  </footer>

  <!-- Client-side Mermaid render for any ```mermaid blocks in the docs (e.g. DIAGRAMS).
       External (not inline) so the CSP needs no script 'unsafe-inline'. -->
  <script src="{{ '/assets/mermaid-init.js' | url }}" defer></script>

  <!-- Per-page Save-as-PDF (print) + Share (Web Share API / copy). External for the strict CSP. -->
  <script src="{{ '/assets/pagetools.js' | url }}" defer></script>

  <!-- Contents filter (progressive enhancement) + document-metadata typographic tightening
       (render-invariant: text and position unchanged). External for the strict CSP. -->
  <script src="{{ '/assets/nav-filter.js' | url }}" defer></script>
  <script src="{{ '/assets/docmeta.js' | url }}" defer></script>

  <!-- Privacy-respecting, cookieless page-view analytics — the author's shared GoatCounter
       dashboard, the same endpoint used across the companion sites. SRI-pinned. -->
  <script data-goatcounter="https://hulkiokantabak.goatcounter.com/count"
          async src="https://gc.zgo.at/count.v5.js"
          integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"
          crossorigin="anonymous"></script>
</body>
</html>
